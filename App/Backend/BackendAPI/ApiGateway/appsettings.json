{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Configuration for YARP (Yet Another Reverse Proxy)
  "ReverseProxy": {
    //Collection of routes
    "Routes": {
      "Service1Route": {
        "ClusterId": "Service1Cluster",
        "Match": {
          "Path": "/api/Service1/{**catch-all}"
        }
      },
      "Service2Route": {
        "ClusterId": "Service2Cluster",
        "Match": {
          "Path": "/api/Service2/{**catch-all}"
        }
      },
      "EmployeeRoute": {
        "ClusterId": "EmployeeCluster",
        "Match": {
          "Path": "/api/Employee/{**catch-all}"
        }
      },
      "DepartmentRoute": {
        "ClusterId": "DepartmentCluster",
        "Match": {
          "Path": "/api/Department/{**catch-all}"
        }
      }
    },
    //Collection of clusters
    "Clusters": {
      "Service1Cluster": {
        "Destinations": {
          "Service1Api1": {
            //Address of the destination service - mandatory field
            "Address": "https://localhost:7244",
            //Its health check endpoint - optional field - performed periodically by YARP
            "Health": "/health",
            //Host header to be used when forwarding requests - optional field
            "Host": "",
            //Additional metadata for custom use - optional field
            "Metadata": null
          }
          //Second destination for testing load balancing - share load with first destination
          //"Service1Api2": {
          //  "Address": "http://localhst:9000"
          //}
        }
      },
      "Service2Cluster": {
        "Destinations": {
          "Service2Api1": {
            "Address": "https://localhost:7132"
          }
        }
      },
      "EmployeeCluster": {
        "Destinations": {
          "EmployeeApi1": {
            "Address": "https://localhost:7149"
          }
        }
      },
      "DepartmentCluster": {
        "Destinations": {
          "DepartmentApi1": {
            "Address": "https://localhost:7022"
          }
        }
      }

    }
  }
}
