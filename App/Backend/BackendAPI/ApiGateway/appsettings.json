{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Configuration for YARP (Yet Another Reverse Proxy)
  "ReverseProxy": {
    //Collection of routes
    "Routes": {
      "HelloRoute": {
        "ClusterId": "HelloCluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    //Collection of clusters
    "Clusters": {
      "HelloCluster": {
        "Destinations": {
          "HelloApi": {
            //Address of the destination service - mandatory field
            "Address": "https://localhost:7211",
            //Its health check endpoint - optional field - performed periodically by YARP
            "Health": "/health",
            //Host header to be used when forwarding requests - optional field
            "Host": "",
            //Additional metadata for custom use - optional field
            "Metadata": null
          }
          //Second destination for testing load balancing - share load with first destination
          //"HelloApi2": {
          //  "Address": "http://localhst:9000"
          //}
        }
      }
    }
  }
}
